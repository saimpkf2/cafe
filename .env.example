# Copy to .env. Existing service environment variables take precedence.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-cafe-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-cafe-domain.example
# Required. URL-encode special characters in username/password.
DATABASE_URL=postgresql://username:password@localhost:5432/cafe

# Railway deployment instructions: RAILWAY.md
# Optional Gunicorn worker count:
WEB_CONCURRENCY=2
